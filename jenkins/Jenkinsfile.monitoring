pipeline {
    agent {
        label 'devops-agent'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy monitoring') {
            steps {
                sh '''
                    set -eu

                    work_dir="$(mktemp -d)"
                    export KUBECONFIG="$work_dir/kubeconfig"
                    trap 'rm -rf "$work_dir"' EXIT

                    aws eks update-kubeconfig \
                      --name hv-capstone-dev \
                      --region "$AWS_DEFAULT_REGION"

                    kubectl -n monitoring get secret \
                      monitoring-grafana-admin \
                      capstone-alertmanager-config \
                      -o name

                    controller_ip="$(aws ec2 describe-instances \
                      --region "$AWS_DEFAULT_REGION" \
                      --filters \
                        Name=tag:Name,Values=hv-capstone-jenkins-controller \
                        Name=instance-state-name,Values=running \
                      --query 'Reservations[].Instances[].PublicIpAddress' \
                      --output text \
                      --no-cli-pager)"

                    export CAPSTONE_CONTROLLER_IP="$controller_ip"
                    python3 -c 'import ipaddress, os; ipaddress.IPv4Address(os.environ["CAPSTONE_CONTROLLER_IP"]); print("Controller IPv4 address validated")'

                    sed "s/JENKINS_CONTROLLER_IP/$controller_ip/g" \
                      monitoring/jenkins-scrape-values.yaml \
                      > "$work_dir/jenkins-scrape-values.yaml"

                    helm upgrade --install \
                      capstone-monitoring \
                      oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack \
                      --version 92.14.0 \
                      --namespace monitoring \
                      -f monitoring/values.yaml \
                      -f "$work_dir/jenkins-scrape-values.yaml" \
                      --wait \
                      --timeout 10m

                    kubectl apply -f monitoring/app-servicemonitor.yaml
                    kubectl apply -f monitoring/app-dashboard.json
                    kubectl apply -f monitoring/app-alerts.yaml

                    kubectl -n monitoring get pods
                '''
            }
        }
    }

    post {
        failure {
            emailext(
                to: 'sammsulhoq@gmail.com',
                from: 'sammsulhoq@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Monitoring pipeline failed. Inspect: ${env.BUILD_URL}"
            )
        }
    }
}
