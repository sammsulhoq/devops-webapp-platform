pipeline {
    agent {
        label 'devops-agent'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        ECR_REGISTRY       = '483510445289.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY     = 'hv-capstone-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def commitId = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                    env.IMAGE_TAG = "${commitId}-${env.BUILD_NUMBER}"
                    env.IMAGE_URI = "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"
                }
                echo "Image: ${env.IMAGE_URI}"
            }
        }

        stage('Test application') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$WORKSPACE:/workspace:ro" \
                      -w /workspace \
                      -e PYTHONDONTWRITEBYTECODE=1 \
                      python:3.12-slim \
                      sh -c 'python -m pip install -r requirements-dev.txt && python -m pytest -q -p no:cacheprovider'
                '''
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build -t "$IMAGE_URI" .'
            }
        }

        stage('Push image to ECR') {
            steps {
                sh '''
                    set -eu
                    export DOCKER_CONFIG="$(mktemp -d)"
                    trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                    aws ecr get-login-password --region "$AWS_DEFAULT_REGION" |
                      docker login --username AWS --password-stdin "$ECR_REGISTRY"

                    docker push "$IMAGE_URI"
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    set -eu

                    work_dir="$(mktemp -d)"
                    export KUBECONFIG="$work_dir/kubeconfig"
                    trap 'rm -rf "$work_dir"' EXIT

                    aws eks update-kubeconfig \
                      --name hv-capstone-dev \
                      --region "$AWS_DEFAULT_REGION"

                    sed -e "s|hv-capstone-app:initial|hv-capstone-app:$IMAGE_TAG|" -e "s|value: .*initial.*|value: $IMAGE_TAG|" \
                      kubernetes/deployment.yaml > "$work_dir/deployment.yaml"

                    kubectl apply -f kubernetes/service.yaml
                    kubectl apply -f kubernetes/hpa.yaml
                    kubectl apply -f "$work_dir/deployment.yaml"
                    kubectl rollout status deployment/devops-webapp --timeout=180s
                    kubectl apply -f kubernetes/ingress.yaml

                    kubectl exec deployment/devops-webapp -- python -c '
import json
import sys
from urllib.request import urlopen

with urlopen("http://devops-webapp/api/info", timeout=10) as response:
    data = json.load(response)

print("Application response:", data)
if data.get("version") != sys.argv[1]:
    raise SystemExit("Deployed application version does not match this build")
' "$IMAGE_TAG"
                '''
            }
        }
    }

    post {
        failure {
            emailext(
                to: 'sammsulhoq@gmail.com',
                from: 'sammsulhoq@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """The application pipeline failed.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
Details: ${env.BUILD_URL}

Open the build console to inspect the failed stage.
"""
            )
        }
    }
}
